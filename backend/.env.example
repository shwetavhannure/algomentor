# ---------- AlgoMentor backend ----------
PORT=5000
NODE_ENV=development

# MongoDB: default works if MongoDB Community is installed locally.
# For Atlas, paste your connection string here (mongodb+srv://user:pass@cluster/dbname)
MONGO_URI=mongodb://127.0.0.1:27017/algomentor

# Already generated for you. Keep it secret, change it in production.
JWT_SECRET=change_this_to_a_long_random_string

# AI providers: set at least ONE key. Hints use whichever models have a key.
# Groq (free tier):  https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Optional extra providers (enable more models in the dropdown)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: default model id and extra models, e.g. EXTRA_MODELS=openai:gpt-4.1-mini
DEFAULT_MODEL=llama-3.3-70b-versatile

# Optional: Google sign-in (leave as is to hide/disable the Google button)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

CLIENT_URL=http://localhost:5173
